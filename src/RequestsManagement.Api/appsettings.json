{
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "MaxSearchLength": 100
  },
  "BulkUpdate": {
    "MaxItems": 100
  },
  "OpenApi": {
    "Enabled": false
  },
  "Cache": {
    "SummaryExpiration": "00:01:00",
    "SummaryLocalExpiration": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
